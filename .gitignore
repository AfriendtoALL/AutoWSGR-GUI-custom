# 排除 Electron/Chromium 运行库和可执行文件
*.exe
*.dll
*.pak
*.dat
*.bin
*.html
*.txt
*.json
# 模板清单是运行时校验数据，需随源码分发
!python/site-packages/autowsgr/image_resources/manifest.json
# golden set 基线是测试数据，需随源码分发
!tests/golden/expectations.json
# AST 审计基线是测试数据，需随源码分发
!tests/audit_click_sleep_baseline.json
*.so
*.dylib
*.blob

# 排除第三方运行时和资源目录；仅放行后端源码包 autowsgr/
python/*
!python/site-packages/
python/site-packages/*
!python/site-packages/autowsgr/
adb/
redist/
locales/
resources/

# 排除 Python 字节码
__pycache__/
*.pyc

# 排除随包分发的二进制件（OCR 模型约 30 MB、scrcpy-server.jar）
python/site-packages/autowsgr/data/ocr/**/*.onnx
*.jar

# 排除体积较大的二进制素材：本地回归基准图与开发参考截图（源码仓库不收录）
SCS/
tests/golden/images/

# 排除日志、缓存和临时文件
logs/
.workbuddy/
.env_ready

# 排除你自己的编译产物或不需要同步的目录（视情况保留）
# dist/
# build/
